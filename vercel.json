{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/services/",
      "destination": "/business/",
      "permanent": true
    },
    {
      "source": "/services/web-platforms/",
      "destination": "/business/website-development/",
      "permanent": true
    },
    {
      "source": "/services/ai-automation/",
      "destination": "/business/custom-software-development/",
      "permanent": true
    },
    {
      "source": "/services/mobile-apps/",
      "destination": "/business/custom-software-development/",
      "permanent": true
    },
    {
      "source": "/services/iot-solutions/",
      "destination": "/business/custom-software-development/",
      "permanent": true
    },
    {
      "source": "/services/cloud-devops/",
      "destination": "/business/custom-software-development/",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "/business/",
      "permanent": true
    },
    {
      "source": "/solutions/:path*",
      "destination": "/business/",
      "permanent": true
    },
    {
      "source": "/academic-services/:path*",
      "destination": "/student-projects/",
      "permanent": true
    },
    {
      "source": "/images/zenith-original-navbar.png",
      "destination": "/zenith-logo.png",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/work/:slug/",
      "destination": "/projects/:slug/",
      "permanent": true
    },
    {
      "source": "/insights/",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/insights/:id/",
      "destination": "/resources/:id/",
      "permanent": true
    }
  ]
}
