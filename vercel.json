{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/images/zenith-original-navbar.png",
      "destination": "/zenith-nav-logo.svg",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/work/:slug/",
      "destination": "/projects/:slug/",
      "permanent": true
    },
    {
      "source": "/insights/",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/insights/:id/",
      "destination": "/resources/:id/",
      "permanent": true
    }
  ]
}